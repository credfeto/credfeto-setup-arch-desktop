#! /bin/sh

BASEDIR="$(dirname "$(readlink -f "$0")")"

# shellcheck source=lib/common disable=SC1091
. "$BASEDIR/lib/common"

info "Script Dir: $BASEDIR"
info "Installing..."
"$BASEDIR/install.d/remove-aur-helpers"
"$BASEDIR/install.d/harden-system"
"$BASEDIR/install.d/pacman-hooks"
"$BASEDIR/install.d/configure-pacman"
"$BASEDIR/install.d/security-tools"
"$BASEDIR/install.d/dash"
"$BASEDIR/install.d/configure-network"
"$BASEDIR/install.d/harden-ssh" || die "install.d/harden-ssh failed"
"$BASEDIR/install.d/btrfs-scrub"
"$BASEDIR/install.d/firejail"
"$BASEDIR/install.d/fail2ban"
"$BASEDIR/install.d/enable-services"
"$BASEDIR/install.d/shell-prompt" || die "install.d/shell-prompt failed"
"$BASEDIR/install.d/shell-environment"
"$BASEDIR/install.d/configure-flatpak"
"$BASEDIR/install.d/git-environment" || die "install.d/git-environment failed"
"$BASEDIR/install.d/dev-scripts" || die "install.d/dev-scripts failed"
success "Done"
