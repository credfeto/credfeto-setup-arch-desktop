#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$(dirname "$(dirname "$SCRIPTDIR")")")"

# shellcheck source=../../../lib/common disable=SC1091
. "$BASEDIR/lib/common"

# Non-blocking so an overlapping timer tick or manual run exits cleanly
# instead of queueing up behind the one already running.
acquire_lock() {
    [ -n "${XDG_RUNTIME_DIR}" ] || die "XDG_RUNTIME_DIR is not set"

    exec 9>"${XDG_RUNTIME_DIR}/dev-update.lock"
    if ! flock -n 9; then
        info "dev-update is already running"
        exit 0
    fi
}

update_repo() {
    REPO_PATH="${DEV_REFERENCE_DIR}/$1"

    [ -d "${REPO_PATH}" ] || die "Reference clone not found: ${REPO_PATH} (run dev-install)"

    info "Pulling ${REPO_PATH}..."
    git -C "${REPO_PATH}" pull || die "Failed to pull ${REPO_PATH}"
}

run_install_step() {
    INSTALL_SCRIPT="${DEV_REFERENCE_DIR}/$1"
    shift

    [ -x "${INSTALL_SCRIPT}" ] || die "Install script not found or not executable: ${INSTALL_SCRIPT}"

    info "Running ${INSTALL_SCRIPT} $*..."
    "${INSTALL_SCRIPT}" "$@" || die "Failed to run ${INSTALL_SCRIPT}"
}

dev_update() {
    refuse_ai_agent dev-update
    acquire_lock
    require_network "$SCRIPTDIR/network-online"

    for REPO in $DEV_REFERENCE_REPOS; do
        update_repo "${REPO}"
    done

    run_install_step credfeto-setup-arch-desktop/install.d/dev-scripts
    run_install_step credfeto-global-pre-commit/install --system
    run_install_step claude/install
    run_install_step credfeto-ai-skills/install
    run_install_step credfeto-orchestrator/install-claude-hooks

    update-dotnet-tools

    success "Dev environment updated"
}

dev_update
