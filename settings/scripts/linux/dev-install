#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$(dirname "$(dirname "$SCRIPTDIR")")")"

# shellcheck source=../../../lib/common disable=SC1091
. "$BASEDIR/lib/common"

require_dotnet() {
    command -v dotnet >/dev/null 2>&1 || die "dotnet is not on PATH"
}

# The dev-update units and 95_update.sh only look in the default location,
# so clones anywhere else would leave the timer skipping every tick unseen.
require_default_reference_dir() {
    [ "${DEV_REFERENCE_DIR}" = "${DEV_REFERENCE_DEFAULT_DIR}" ] || die "DEV_REFERENCE_DIR is set to ${DEV_REFERENCE_DIR}, but only the default ${DEV_REFERENCE_DEFAULT_DIR} is supported; unset it and re-run"
}

# Started only after dev-install's own dev-update run, so a tick cannot race
# it for the lock. A timer that has never fired fires at once on start,
# because OnStartupSec= has already passed, so one more dev-update run
# follows shortly; it finds everything already up to date.
start_dev_update_timer() {
    info "Starting dev-update.timer..."
    systemctl --user start dev-update.timer || die "Failed to start dev-update.timer"
}

dev_install() {
    refuse_ai_agent dev-install
    require_default_reference_dir
    require_network "$SCRIPTDIR/network-online"
    require_dotnet

    # On a re-run the clones already exist and may be stale or on another
    # branch, so each is brought to the latest main before anything runs
    # from it; for a fresh clone this is a no-op pull.
    for REPO in $DEV_REFERENCE_REPOS; do
        clone_reference_repo "${REPO}"
        update_reference_repo "${REPO}"
    done

    info "Installing dotnet tools..."
    (cd "${HOME}" && install-dotnet-tools) || die "Failed to install dotnet tools"

    # Run from the reference clone rather than this checkout, so the unit
    # symlinks and the /usr/local/bin links dev-update creates resolve there.
    run_reference_step credfeto-setup-arch-desktop/units/dev-update/install
    run_reference_step credfeto-setup-arch-desktop/settings/scripts/linux/dev-update
    start_dev_update_timer

    success "Dev environment installed"
}

dev_install
