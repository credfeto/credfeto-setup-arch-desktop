#! /bin/sh

# Standalone by design: no lib/ dependency, no assumption about where this
# script itself lives on disk. It used to source a lib/common shared by
# credfeto-setup-arch-desktop's own install.d/* scripts (DOCKER_INSTALLED and
# other desktop-installer flags this script never used), copied in by mistake
# and never actually deployed anywhere alongside it - die/info/success are
# inlined here instead.
_emit() {
    fd=$1
    color=$2
    symbol=$3
    shift 3
    if [ -t "$fd" ]; then
        printf '\n\033[%sm%s\033[0m %s\n' "$color" "$symbol" "$*"
    else
        printf '\n%s %s\n' "$symbol" "$*"
    fi
}

die() {
    _emit 2 31 '✗' "$*" >&2
    exit 1
}

success() {
    _emit 1 32 '✓' "$*"
}

info() {
    _emit 1 32 '→' "$*"
}

# Same check at every level: does <hooks-folder>/pre-commit exist and is it
# executable? Tried in order: repo's own hooks folder, system, global.
hook_in() {
    [ -n "$1" ] && [ -x "$1/pre-commit" ] && printf '%s/pre-commit\n' "$1"
}

# No origin remote at all (e.g. a scratch local-only repo) - nothing to
# compare against, so skip the up-to-date check entirely.
if git remote get-url origin >/dev/null 2>&1; then
    git fetch origin --quiet || die "Could not fetch origin - check your network/credentials"

    DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
    [ -n "$DEFAULT_BRANCH" ] || DEFAULT_BRANCH="main"

    # Check against the current branch's own upstream (if it has one) *and*
    # against the remote's default branch, so a feature branch that's fully
    # merged with its own upstream but stale against main still gets caught.
    OWN_UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)

    # Left/right counts rather than a single HEAD..upstream count: after a
    # local rebase every commit gets a new SHA, so HEAD and its unpushed
    # upstream ref diverge (both ahead and behind) even though there's no
    # missing work. Only a pure behind (nothing ahead) means the branch
    # itself is stale and needs pulling/rebasing.
    if [ -n "$OWN_UPSTREAM" ]; then
        # shellcheck disable=SC2046 # intentional word split of "N M" into $1 $2
        set -- $(git rev-list --left-right --count "$OWN_UPSTREAM"...HEAD)
        BEHIND=$1
        AHEAD=$2
        if [ "$BEHIND" -gt 0 ] && [ "$AHEAD" -eq 0 ]; then
            die "Local branch is $BEHIND commit(s) behind $OWN_UPSTREAM - pull/rebase first"
        fi
    fi

    if git rev-parse --verify --quiet "origin/$DEFAULT_BRANCH" >/dev/null && [ "$OWN_UPSTREAM" != "origin/$DEFAULT_BRANCH" ]; then
        BEHIND=$(git rev-list --count HEAD.."origin/$DEFAULT_BRANCH")
        [ "$BEHIND" -gt 0 ] && die "Local branch is $BEHIND commit(s) behind origin/$DEFAULT_BRANCH - pull/rebase first"
    fi
fi

GIT_DIR=$(git rev-parse --absolute-git-dir 2>/dev/null)
REPO_HOOKS_DIR=""
[ -n "$GIT_DIR" ] && REPO_HOOKS_DIR="$GIT_DIR/hooks"
HOOK=$(hook_in "$REPO_HOOKS_DIR")

[ -n "$HOOK" ] || HOOK=$(hook_in "$(git config --system --get core.hooksPath 2>/dev/null)")
[ -n "$HOOK" ] || HOOK=$(hook_in "$(git config --global --get core.hooksPath 2>/dev/null)")

[ -n "$HOOK" ] || die "No pre-commit hook found in the repo's hooks folder, system hooksPath, or global hooksPath"

info "Running $HOOK --all-files"
"$HOOK" --all-files || die "pre-commit hook failed"
success "Pre-commit checks passed"
