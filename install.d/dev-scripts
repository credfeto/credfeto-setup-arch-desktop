#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

# shellcheck source=../lib/common disable=SC1091
. "$BASEDIR/lib/common"

# Overridable so this script is testable without real root/sudo (tests point
# them at temp dirs they already own); default to the real system locations.
DEV_SCRIPTS_BIN_DIR="${DEV_SCRIPTS_BIN_DIR:-/usr/local/bin}"
DEV_SCRIPTS_LIB_DIR="${DEV_SCRIPTS_LIB_DIR:-/usr/local/lib/credfeto-setup-arch-desktop}"
DEV_SCRIPTS_LIB_PARENT="$(dirname "$DEV_SCRIPTS_LIB_DIR")"
# Hidden, so it never matches the copies remove_old_copies deletes.
DEV_SCRIPTS_LOCK_FILE="$DEV_SCRIPTS_LIB_PARENT/.$(basename "$DEV_SCRIPTS_LIB_DIR").lock"
DEV_SCRIPTS_SOURCE_DIRS="db development general git linux"

# The installed scripts are read by every account, so nothing created here
# may take a mode from the caller's umask.
umask 022

# Runs the command directly when the given directory is already writable by
# the invoking user (or can be created by them), otherwise through sudo -
# keeps this runnable without real root under test, while still using sudo
# for the real system locations.
# Usage: dev_scripts_sudo_in <dir> <command> [<arg> ...]
dev_scripts_sudo_in() {
    SUDO_DIR="$1"
    shift
    if [ -w "$SUDO_DIR" ] || { [ ! -e "$SUDO_DIR" ] && [ -w "$(dirname "$SUDO_DIR")" ]; }; then
        "$@"
    else
        sudo "$@"
    fi
}

dev_scripts_sudo() {
    dev_scripts_sudo_in "$DEV_SCRIPTS_BIN_DIR" "$@"
}

dev_scripts_lib_sudo() {
    dev_scripts_sudo_in "$DEV_SCRIPTS_LIB_PARENT" "$@"
}

# Prints, relative to settings/scripts/, the path of every executable regular
# file across all source directories, one per line.
list_dev_scripts() {
    for DIR in $DEV_SCRIPTS_SOURCE_DIRS; do
        SRC_DIR="$BASEDIR/settings/scripts/$DIR"
        [ -d "$SRC_DIR" ] || continue

        for SCRIPT in "$SRC_DIR"/*; do
            [ -f "$SCRIPT" ] || continue
            [ -x "$SCRIPT" ] || continue

            printf '%s/%s\n' "$DIR" "${SCRIPT##*/}"
        done
    done
}

check_no_collisions() {
    DUPLICATES=$(printf '%s\n' "$DEV_SCRIPT_PATHS" | sed 's|.*/||' | sort | uniq -d)
    if [ -n "$DUPLICATES" ]; then
        die "Duplicate script name(s) across settings/scripts/: $(printf '%s' "$DUPLICATES" | tr '\n' ' ')"
    fi
}

# Prints, relative to BASEDIR, lib/ and every source directory that exists:
# the parts of the repo the installed scripts load at run time.
list_copied_roots() {
    printf '%s\n' lib
    for DIR in $DEV_SCRIPTS_SOURCE_DIRS; do
        if [ -d "$BASEDIR/settings/scripts/$DIR" ]; then
            printf '%s\n' "settings/scripts/$DIR"
        fi
    done
}

# Copies lib/ and the source directories into a new folder, keeping their
# paths relative to BASEDIR, as the scripts find lib/common and their sibling
# files relative to their own real path. Every file is copied, not just the
# linked ones, with its mode stated explicitly: 755 when executable in the
# checkout, 644 otherwise.
# Usage: copy_dev_scripts <target-dir>
copy_dev_scripts() {
    TARGET_DIR="$1"
    COPY_ROOTS=$(list_copied_roots)

    # Folders before the files in them: find lists a folder before its contents.
    # shellcheck disable=SC2086 # COPY_ROOTS is a list of repo-relative paths with no spaces.
    COPY_ENTRIES=$(cd "$BASEDIR" && find $COPY_ROOTS \( -type d -o -type f \)) || die "Failed to list the files to copy from $BASEDIR"

    while IFS= read -r REL_PATH; do
        if [ -d "$BASEDIR/$REL_PATH" ]; then
            dev_scripts_lib_sudo install -d -m 755 "$TARGET_DIR/$REL_PATH" || die "Failed to create $TARGET_DIR/$REL_PATH"
            continue
        fi

        MODE=644
        if [ -x "$BASEDIR/$REL_PATH" ]; then
            MODE=755
        fi
        dev_scripts_lib_sudo install -m "$MODE" "$BASEDIR/$REL_PATH" "$TARGET_DIR/$REL_PATH" || die "Failed to copy $REL_PATH to $TARGET_DIR"
    done <<EOF
$COPY_ENTRIES
EOF

    # Always sudo: only root can give files to root, even in a writable directory.
    sudo chown -R root:root "$TARGET_DIR" || die "Failed to make $TARGET_DIR owned by root"
}

# Takes the run lock beside DEV_SCRIPTS_LIB_DIR and holds it until this
# script exits. A manual install and the dev-update timer's run each remove
# the copies they do not keep, so two runs at once could delete the copy the
# other is about to switch to. Non-blocking, so a second run stops at once
# rather than queueing behind the first and then replacing what it made.
lock_dev_scripts_install() {
    dev_scripts_lib_sudo mkdir -p "$DEV_SCRIPTS_LIB_PARENT" || die "Failed to create $DEV_SCRIPTS_LIB_PARENT"

    # touch and chmod keep an existing file's inode, so a run already holding
    # the lock still excludes this one; chmod, rather than the umask, makes
    # the file readable by every account. Only ever opened for reading, which
    # flock allows, so whoever owns it never stops anyone else taking the lock.
    # Never removed: a run that recreated it would lock a different file from
    # a run already holding the old one.
    [ -r "$DEV_SCRIPTS_LOCK_FILE" ] || { dev_scripts_lib_sudo touch "$DEV_SCRIPTS_LOCK_FILE" && dev_scripts_lib_sudo chmod 0644 "$DEV_SCRIPTS_LOCK_FILE"; } || die "Failed to create $DEV_SCRIPTS_LOCK_FILE"

    # command, as a failed redirection on a bare exec ends a POSIX shell
    # before the die can name the lock.
    command exec 9<"$DEV_SCRIPTS_LOCK_FILE" || die "Failed to open $DEV_SCRIPTS_LOCK_FILE"
    flock -n 9 || die "Another dev-scripts install holds $DEV_SCRIPTS_LOCK_FILE"
}

# Builds a fresh copy in a new versioned folder beside DEV_SCRIPTS_LIB_DIR,
# then switches DEV_SCRIPTS_LIB_DIR (a symlink) to it. The links in
# DEV_SCRIPTS_BIN_DIR go through the stable DEV_SCRIPTS_LIB_DIR path, so they
# never need re-pointing, and a script already running from the previous
# copy keeps working. Leaves the new and previous copies' names in COPY_NAME
# and PREVIOUS_NAME for the caller to keep.
install_dev_scripts_copy() {
    LIB_PARENT="$DEV_SCRIPTS_LIB_PARENT"
    LIB_NAME="$(basename "$DEV_SCRIPTS_LIB_DIR")"
    # Nanoseconds so two installs within the same second never collide.
    COPY_NAME="$LIB_NAME-$(date -u +%Y%m%dT%H%M%S.%NZ)" || die "Failed to name a new copy of the dev scripts"
    COPY_DIR="$LIB_PARENT/$COPY_NAME"

    info "Copying dev scripts to $COPY_DIR"
    dev_scripts_lib_sudo mkdir -m 755 "$COPY_DIR" || die "Failed to create $COPY_DIR"
    copy_dev_scripts "$COPY_DIR"

    PREVIOUS_NAME="$(readlink "$DEV_SCRIPTS_LIB_DIR" 2>/dev/null)" || PREVIOUS_NAME=""
    # A new link renamed over the old one, so the path is never missing or
    # half-switched for a script being run through it.
    dev_scripts_lib_sudo ln -sfn "$COPY_NAME" "$LIB_PARENT/.$LIB_NAME.tmp" || die "Failed to create a link to $COPY_DIR"
    dev_scripts_lib_sudo mv -T "$LIB_PARENT/.$LIB_NAME.tmp" "$DEV_SCRIPTS_LIB_DIR" || die "Failed to switch $DEV_SCRIPTS_LIB_DIR to $COPY_DIR"
}

# Deletes every copy but the two named ones; also clears any partial copy a
# failed run left behind. Only called once the current copy exists, so the
# glob always matches at least that and never comes through unexpanded.
# Usage: remove_old_copies <current-copy-name> <previous-copy-name>
remove_old_copies() {
    KEEP_CURRENT="$1"
    KEEP_PREVIOUS="$2"
    for OLD_COPY in "$DEV_SCRIPTS_LIB_DIR"-[0-9]*Z; do
        case "${OLD_COPY##*/}" in
            "$KEEP_CURRENT" | "$KEEP_PREVIOUS") continue ;;
        esac

        info "Removing old copy $OLD_COPY"
        # Always sudo: copy_dev_scripts gave the copy to root, so only root can
        # empty its folders, even when the folder holding it is writable.
        sudo rm -rf "$OLD_COPY" || die "Failed to remove the old copy $OLD_COPY"
    done
}

# Succeeds when the given symlink points into the installed copy or into a
# settings/scripts/ tree of this repo: this checkout's, or any other checkout
# of it. Links into a checkout were made by earlier versions of this script,
# from either the working checkout or the reference clone, so they are still
# recognised to be replaced or pruned. The stored target is matched as well
# as the resolved one, because readlink -f gives nothing once the other
# checkout's directory is gone.
is_dev_script_link() {
    case "$(readlink "$1")" in
        "$DEV_SCRIPTS_LIB_DIR"/settings/scripts/* | "$BASEDIR"/settings/scripts/* | */credfeto-setup-arch-desktop/settings/scripts/*) return 0 ;;
    esac
    case "$(readlink -f "$1" 2>/dev/null)" in
        "$BASEDIR"/settings/scripts/*) return 0 ;;
    esac
    return 1
}

# Removes any dangling symlink in DEV_SCRIPTS_BIN_DIR that is_dev_script_link
# recognises (the script was renamed or removed since a prior install run,
# or that checkout is gone). Leaves every live symlink, and every
# symlink/file pointing anywhere else, untouched.
prune_stale_symlinks() {
    [ -d "$DEV_SCRIPTS_BIN_DIR" ] || return 0

    for LINK in "$DEV_SCRIPTS_BIN_DIR"/*; do
        [ -L "$LINK" ] || continue
        [ ! -e "$LINK" ] || continue
        is_dev_script_link "$LINK" || continue

        info "Removing stale symlink $LINK"
        dev_scripts_sudo rm -f "$LINK" || die "Failed to remove stale symlink $LINK"
    done
}

link_dev_scripts() {
    # Fed from a here-doc rather than a pipe so the loop runs in this shell
    # and a die inside it stops the whole script instead of just a subshell.
    while IFS= read -r SCRIPT; do
        [ -n "$SCRIPT" ] || continue

        NAME="${SCRIPT##*/}"
        info "Linking $NAME"
        dev_scripts_sudo ln -sf "$DEV_SCRIPTS_LIB_DIR/settings/scripts/$SCRIPT" "$DEV_SCRIPTS_BIN_DIR/$NAME" || die "Failed to link $DEV_SCRIPTS_BIN_DIR/$NAME"
    done <<EOF
$DEV_SCRIPT_PATHS
EOF
}

install_dev_scripts() {
    info "Installing dev scripts into $DEV_SCRIPTS_BIN_DIR"

    DEV_SCRIPT_PATHS=$(list_dev_scripts)

    check_no_collisions

    dev_scripts_sudo install -d -m 755 "$DEV_SCRIPTS_BIN_DIR" || die "Failed to create $DEV_SCRIPTS_BIN_DIR"

    lock_dev_scripts_install

    install_dev_scripts_copy

    # After the switch: a script removed from the checkout is still in the
    # previous copy, so its link only dangles once the new copy is in place.
    prune_stale_symlinks

    link_dev_scripts

    remove_old_copies "$COPY_NAME" "$PREVIOUS_NAME"

    success "Dev scripts installed"
}

install_dev_scripts
