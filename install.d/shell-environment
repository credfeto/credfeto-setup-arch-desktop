#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

# shellcheck source=../lib/common disable=SC1091
. "$BASEDIR/lib/common"

# Deploys one shell config file into a directory every user's shell reads,
# so it is world-readable whatever the checkout mode or umask.
# Usage: install_shell_file <source> <target-dir>
install_shell_file() {
    SHELL_FILE_TARGET="$2/$(basename "$1")"
    sudo install -m 0644 "$1" "$SHELL_FILE_TARGET" || die "Failed to install $SHELL_FILE_TARGET"
}

# Deploys every *.sh file in a settings directory into each target directory.
# Fails when the directory is missing or holds none, which would otherwise
# report a successful install with nothing deployed.
# Usage: install_shell_files <source-dir> <target-dir> [<target-dir> ...]
install_shell_files() {
    SHELL_FILES_DIR="$1"
    shift
    SHELL_FILES_FOUND=0
    for SOURCE in "$SHELL_FILES_DIR"/*.sh; do
        [ -f "$SOURCE" ] || continue
        SHELL_FILES_FOUND=1
        for TARGET_DIR in "$@"; do
            install_shell_file "$SOURCE" "$TARGET_DIR"
        done
    done
    [ "$SHELL_FILES_FOUND" -eq 1 ] || die "No shell config files found in $SHELL_FILES_DIR"
}

install_shell_environment() {
    info "Installing autojump"
    sudo pacman -S --needed --noconfirm autojump || die "Failed to install autojump"

    info "Installing shared environment (profile.d + bash.bashrc.d)"
    sudo install -d -m 755 /etc/bash.bashrc.d || die "Failed to create /etc/bash.bashrc.d"

    # Shared: deployed to both /etc/profile.d (login shells, GUI sessions,
    # systemd units) and /etc/bash.bashrc.d (which /etc/bash.bashrc sources in
    # every interactive bash shell), so anything that is not bash still sees
    # them.
    install_shell_files "$BASEDIR/settings/shell-env" /etc/profile.d /etc/bash.bashrc.d

    # Bash-only, not interactive-only: run-dev-update also sources these
    # sections, from its clone, in a non-interactive bash.
    info "Installing bash-only config (bash.bashrc.d)"
    install_shell_files "$BASEDIR/settings/bash.bashrc.d" /etc/bash.bashrc.d

    if grep -qF "# BEGIN credfeto-setup-arch-desktop bash.bashrc.d" /etc/bash.bashrc 2>/dev/null; then
        info "bash.bashrc.d loader block already present in /etc/bash.bashrc, skipping"
    else
        info "Enabling bash.bashrc.d loader in /etc/bash.bashrc"
        sudo tee -a /etc/bash.bashrc > /dev/null << 'BASHRC_D_BLOCK' || die "Failed to add the bash.bashrc.d loader block to /etc/bash.bashrc"
# BEGIN credfeto-setup-arch-desktop bash.bashrc.d
if [ -d /etc/bash.bashrc.d ]; then
    for _bashrc_d_file in /etc/bash.bashrc.d/*.sh; do
        [ -e "$_bashrc_d_file" ] && . "$_bashrc_d_file"
    done
    unset _bashrc_d_file
fi
# END credfeto-setup-arch-desktop bash.bashrc.d
BASHRC_D_BLOCK
    fi

    success "Shell environment installed"
}

install_shell_environment
