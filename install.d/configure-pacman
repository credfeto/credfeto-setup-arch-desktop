#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

# shellcheck source=../lib/common disable=SC1091
. "$BASEDIR/lib/common"

# Overridable so tests can point this at a fixture file instead of the real
# system file; defaults to the live pacman.conf for a real install run.
PACMAN_CONF="${PACMAN_CONF:-/etc/pacman.conf}"

# Escapes a value for use as literal text in a sed basic regular expression
# delimited by "/".
sed_pattern_literal() {
    printf '%s\n' "$1" | sed 's|[[\/.*^$]|\\&|g'
}

# Escapes a value for use as literal text in a sed s/// replacement delimited
# by "/".
sed_replacement_literal() {
    printf '%s\n' "$1" | sed 's|[\/&]|\\&|g'
}

# Escapes a value for use as the text of a GNU sed one-line "a\text" command,
# where a backslash escapes the next character. The leading backslash the
# caller writes after "a" keeps any leading whitespace in the text.
sed_text_literal() {
    printf '%s\n' "$1" | sed 's|\\|\\\\|g'
}

# Ensures a single-word pacman.conf option (e.g. CheckSpace) is active inside
# the [options] section: uncomments it if present but commented out, inserts
# it right after the [options] header if it has no line at all, or leaves it
# alone if already active. Scoped to the [options] section (up to the next
# "[section]" header) so a same-named line elsewhere in the file is never
# touched. The option is matched and written as literal text, never as a
# regular expression.
ensure_pacman_option() {
    option="$1"
    options_section="$(sed -n '/^\[options\]/,/^\[/p' "$PACMAN_CONF")" || die "Failed to read $PACMAN_CONF"
    match="$(printf '%s\n' "$options_section" | grep -Fx -e "$option" -e "#$option" | head -n 1)"

    case "$match" in
        "$option") return 0 ;;
        "#$option")
            pattern="$(sed_pattern_literal "$option")"
            replacement="$(sed_replacement_literal "$option")"
            sudo sed -i "/^\[options\]/,/^\[/{s/^#${pattern}\$/${replacement}/}" "$PACMAN_CONF" || die "Failed to enable $option in $PACMAN_CONF"
            ;;
        *)
            text="$(sed_text_literal "$option")"
            sudo sed -i "/^\[options\]/a\\${text}" "$PACMAN_CONF" || die "Failed to add $option to $PACMAN_CONF"
            ;;
    esac
}

# Takes the options to ensure as arguments, defaulting to the ones this
# install sets, so a test can run the step against options of its own.
configure_pacman() {
    if [ "$#" -eq 0 ]; then
        set -- ILoveCandy CheckSpace VerbosePkgLists
    fi

    info "Configuring pacman options"
    for pacman_option in "$@"; do
        ensure_pacman_option "$pacman_option"
    done

    success "Pacman configured"
}

configure_pacman "$@"
