#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

# shellcheck source=../lib/common disable=SC1091
. "$BASEDIR/lib/common"

install_fail2ban() {
    info "Installing fail2ban"
    # The package creates /etc/fail2ban/jail.d, so it is installed before the jails are copied in.
    sudo pacman -S --needed --noconfirm fail2ban || die "Failed to install fail2ban"
    sudo cp "$BASEDIR/settings/fail2ban/default.local" "/etc/fail2ban/jail.d/default.local" || die "Failed to copy /etc/fail2ban/jail.d/default.local"
    sudo cp "$BASEDIR/settings/fail2ban/ssh.local" "/etc/fail2ban/jail.d/ssh.local" || die "Failed to copy /etc/fail2ban/jail.d/ssh.local"
    sudo systemctl enable --now fail2ban || die "Failed to enable fail2ban"

    success "fail2ban installed"
}

install_fail2ban
