#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

# shellcheck source=../lib/common disable=SC1091
. "$BASEDIR/lib/common"

configure_network() {
    info "Enabling systemd-resolved"
    sudo systemctl enable --now systemd-resolved || die "Failed to enable systemd-resolved"
    sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf || die "Failed to link /etc/resolv.conf"

    # Straight after systemd-resolved, so NetworkManager is only told to use it
    # once it is running, and before dnsmasq is removed, so a failure later on
    # never leaves NetworkManager set to dns=dnsmasq with no dnsmasq installed.
    # A systemd-networkd host has no /etc/NetworkManager to write to.
    if network_manager_active; then
        info "Enabling IPv6 privacy"
        sudo install -m 0644 "$BASEDIR/settings/networkmanager/ip6-privacy.conf" /etc/NetworkManager/conf.d/ip6-privacy.conf || die "Failed to copy /etc/NetworkManager/conf.d/ip6-privacy.conf"

        if [ "$INCUS_INSTALLED" != 1 ]; then
            info "Enabling MAC privacy"
            sudo install -m 0644 "$BASEDIR/settings/networkmanager/wifi_rand_mac.conf" /etc/NetworkManager/conf.d/wifi_rand_mac.conf || die "Failed to copy /etc/NetworkManager/conf.d/wifi_rand_mac.conf"
        else
            info "Skipping MAC privacy because incus is installed"
        fi

        info "Configuring network availability check"
        sudo install -m 0644 "$BASEDIR/settings/networkmanager/connectivity-test.conf" /etc/NetworkManager/conf.d/connectivity-test.conf || die "Failed to copy /etc/NetworkManager/conf.d/connectivity-test.conf"

        info "Configuring network manager DNS"
        sudo install -m 0644 "$BASEDIR/settings/networkmanager/dns.conf" /etc/NetworkManager/conf.d/dns.conf || die "Failed to copy /etc/NetworkManager/conf.d/dns.conf"

        info "Removing NetworkManager dnsmasq drop-ins"
        sudo rm -f /etc/NetworkManager/dnsmasq.d/00-caching.conf || die "Failed to remove /etc/NetworkManager/dnsmasq.d/00-caching.conf"
        sudo rm -f /etc/NetworkManager/dnsmasq.d/01-async-logs.conf || die "Failed to remove /etc/NetworkManager/dnsmasq.d/01-async-logs.conf"
        sudo rm -f /etc/NetworkManager/dnsmasq.d/02-netflix.conf || die "Failed to remove /etc/NetworkManager/dnsmasq.d/02-netflix.conf"
        sudo rm -f /etc/NetworkManager/dnsmasq.d/03-allow-doh.conf || die "Failed to remove /etc/NetworkManager/dnsmasq.d/03-allow-doh.conf"

        info "Installing Network Manager hook"
        sudo install -m 0755 "$BASEDIR/hooks/networkmanager/10-update-timesyncd" /etc/NetworkManager/dispatcher.d/10-update-timesyncd || die "Failed to copy /etc/NetworkManager/dispatcher.d/10-update-timesyncd"

        info "Reloading network manager config"
        sudo nmcli general reload || die "Failed to reload the NetworkManager config"
    else
        info "Skipping the NetworkManager configuration because NetworkManager is not running"
    fi

    info "Removing dnsmasq"
    if systemctl is-enabled dnsmasq >/dev/null 2>&1; then
        sudo systemctl disable --now dnsmasq || die "Failed to disable dnsmasq"
    fi
    if pacman -Qq dnsmasq 2>/dev/null; then
        sudo pacman -Rns --noconfirm dnsmasq || die "Failed to remove dnsmasq"
    fi

    info "Installing firewalld"
    sudo pacman -S --needed --noconfirm firewalld || die "Failed to install firewalld"
    sudo systemctl enable --now firewalld || die "Failed to enable firewalld"
    sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="10.0.0.0/8" port protocol="tcp" port="22" accept' || die "Failed to allow ssh from 10.0.0.0/8"
    sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="192.168.0.0/16" port protocol="tcp" port="22" accept' || die "Failed to allow ssh from 192.168.0.0/16"
    sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="172.16.0.0/20" port protocol="tcp" port="22" accept' || die "Failed to allow ssh from 172.16.0.0/20"

    success "Network configured"
}

configure_network
