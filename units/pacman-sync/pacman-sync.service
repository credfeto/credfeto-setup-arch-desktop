[Unit]
Description=Sync but do not install Pacman Files
Requires=network-online.target
After=network-online.target


[Service]
Type=oneshot

IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# checkupdates runs as root and keeps its database copy at the predictable
# path /tmp/checkup-db-0, so give it a private /tmp no other user can plant.
PrivateTmp=yes

ExecStart=/usr/bin/checkupdates --download
# checkupdates exits 2 when there are no updates, which is not a failure.
# Exit 1 still is, so real errors continue to mark the unit failed.
SuccessExitStatus=2
