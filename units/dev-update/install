#! /bin/sh

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$(dirname "$SCRIPTDIR")")"

# shellcheck source=../../lib/common disable=SC1091
. "$BASEDIR/lib/common"

USER_UNIT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"

install_dev_update_units() {
    info "Installing dev-update user units into ${USER_UNIT_DIR}"

    mkdir -p "${USER_UNIT_DIR}" || die "Failed to create ${USER_UNIT_DIR}"

    for UNIT in dev-update.service dev-update.timer; do
        ln -sfn "${SCRIPTDIR}/${UNIT}" "${USER_UNIT_DIR}/${UNIT}" || die "Failed to link ${UNIT}"
    done

    systemctl --user daemon-reload || die "Failed to reload the user systemd manager"
    # Enabled but not started: starting it now would fire at once, because
    # OnStartupSec= has already passed, and race dev-install's own final
    # dev-update for the lock. dev-install starts it once that run is done.
    systemctl --user enable dev-update.timer || die "Failed to enable dev-update.timer"

    success "dev-update timer enabled"
}

install_dev_update_units
