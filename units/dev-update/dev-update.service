[Unit]
Description=Update the reference development repositories and tools

[Service]
Type=oneshot
# Fallback for a machine where install has not deployed
# /etc/profile.d/30_ssh-agent.sh, which sets the same value.
Environment=SSH_AUTH_SOCK=%t/ssh-agent.socket
# Run straight from the reference clone (%h is the user's home), not through
# the /usr/local/bin symlinks. The path mirrors the DEV_REFERENCE_DIR default
# in lib/common, which a unit cannot source. If the clone is missing, the condition fails to
# exec with exit 203, which is in the 1 to 254 range that skips the unit, so
# the tick is skipped quietly rather than marking the unit failed.
ExecCondition=%h/work/reference/credfeto-setup-arch-desktop/settings/scripts/linux/network-online
# The user manager reads neither /etc/profile.d nor /etc/bash.bashrc.d. The
# login shell reads /etc/profile.d (NUGET_PACKAGES, GNUPGHOME, ...), and
# run-dev-update adds the PATH and dotnet settings dev-update's steps need
# from the clone's bash.bashrc.d sections, which a non-interactive shell
# never reads.
ExecStart=/bin/sh -lc %h/work/reference/credfeto-setup-arch-desktop/units/dev-update/run-dev-update
