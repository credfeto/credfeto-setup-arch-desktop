# shellcheck shell=sh

# Installs and removes the files that give every kind of session the .NET
# environment listed in settings/dotnet-env/dotnet.conf, so the list is the
# only place a value is defined. Sourced after lib/common, with BASEDIR set,
# by install.d/dotnet-environment and settings/scripts/general/uninstall-dotnet.
#
# DOTNET_ENV_SDK_DIR names the SDK the files point at; it defaults to the
# list's DOTNET_ROOT and replaces that value in every file, so
# install-latest-dotnet can pass the SDK it has just installed.
# DOTNET_ENV_ETC_DIR and DOTNET_ENV_BIN_DIR are test seams only, so a test can
# point /etc and /usr/local/bin at folders of its own.

DOTNET_ENV_CONF="$BASEDIR/settings/dotnet-env/dotnet.conf"
DOTNET_ENV_ETC_DIR="${DOTNET_ENV_ETC_DIR:-/etc}"
DOTNET_ENV_BIN_DIR="${DOTNET_ENV_BIN_DIR:-/usr/local/bin}"

DOTNET_ENV_ENVIRONMENT_D_DIR="$DOTNET_ENV_ETC_DIR/environment.d"
DOTNET_ENV_ENVIRONMENT_D_FILE="60-dotnet.conf"
DOTNET_ENV_PROFILE_D_DIR="$DOTNET_ENV_ETC_DIR/profile.d"
DOTNET_ENV_BASHRC_D_DIR="$DOTNET_ENV_ETC_DIR/bash.bashrc.d"
DOTNET_ENV_SHELL_FILE="60_dotnet.sh"
DOTNET_ENV_PAM_DIR="$DOTNET_ENV_ETC_DIR/security"
DOTNET_ENV_PAM_CONF="$DOTNET_ENV_PAM_DIR/pam_env.conf"
DOTNET_ENV_LINK="$DOTNET_ENV_BIN_DIR/dotnet"

# The pam_env.conf block markers. The sed range in
# write_pam_conf_without_dotnet_block spells them out; change them together.
DOTNET_ENV_BLOCK_BEGIN="# BEGIN credfeto-setup-arch-desktop dotnet"
DOTNET_ENV_BLOCK_END="# END credfeto-setup-arch-desktop dotnet"

DOTNET_ENV_HEADER="Generated by credfeto-setup-arch-desktop from settings/dotnet-env/dotnet.conf; edit that list and re-run install-latest-dotnet rather than this file."

# Dies unless the value may be written as it is into every generated file:
# none of them quotes it, and pam_env would expand a $ or @ in it.
# Usage: require_plain_dotnet_env_value <value> <what>
require_plain_dotnet_env_value() {
    case "$1" in
        *[!A-Za-z0-9_./:+-]*) die "$2 holds a character other than letters, digits and . _ / : + -: $1" ;;
    esac
}

# Reads the list into DOTNET_ENV_LINES, one NAME=value per line with
# DOTNET_ROOT set to the SDK, and the SDK into DOTNET_ENV_SDK. Dies on a line
# that is not a plain NAME=value, on a name given twice and when DOTNET_ROOT
# is missing, before anything has been written.
read_dotnet_env_conf() {
    [ -r "$DOTNET_ENV_CONF" ] || die "Cannot read $DOTNET_ENV_CONF"

    DOTNET_ENV_LINES=""
    DOTNET_ENV_NAMES=" "
    DOTNET_ENV_CONF_ROOT=""
    while IFS= read -r DOTNET_ENV_LINE || [ -n "$DOTNET_ENV_LINE" ]; do
        case "$DOTNET_ENV_LINE" in
            '' | '#'*) continue ;;
            *=*) ;;
            *) die "$DOTNET_ENV_CONF: not a NAME=value line: $DOTNET_ENV_LINE" ;;
        esac

        DOTNET_ENV_NAME="${DOTNET_ENV_LINE%%=*}"
        DOTNET_ENV_VALUE="${DOTNET_ENV_LINE#*=}"
        case "$DOTNET_ENV_NAME" in
            '' | [0-9]* | *[!A-Za-z0-9_]*) die "$DOTNET_ENV_CONF: not a valid variable name: $DOTNET_ENV_NAME" ;;
        esac
        require_plain_dotnet_env_value "$DOTNET_ENV_VALUE" "$DOTNET_ENV_CONF: $DOTNET_ENV_NAME"
        case "$DOTNET_ENV_NAMES" in
            *" $DOTNET_ENV_NAME "*) die "$DOTNET_ENV_CONF: $DOTNET_ENV_NAME is set more than once" ;;
        esac
        DOTNET_ENV_NAMES="$DOTNET_ENV_NAMES$DOTNET_ENV_NAME "

        if [ "$DOTNET_ENV_NAME" = DOTNET_ROOT ]; then
            DOTNET_ENV_CONF_ROOT="$DOTNET_ENV_VALUE"
        else
            DOTNET_ENV_LINES="$DOTNET_ENV_LINES$DOTNET_ENV_NAME=$DOTNET_ENV_VALUE
"
        fi
    done < "$DOTNET_ENV_CONF"

    [ -n "$DOTNET_ENV_CONF_ROOT" ] || die "$DOTNET_ENV_CONF does not set DOTNET_ROOT"

    DOTNET_ENV_SDK="${DOTNET_ENV_SDK_DIR:-$DOTNET_ENV_CONF_ROOT}"
    require_plain_dotnet_env_value "$DOTNET_ENV_SDK" "The SDK folder"
    case "$DOTNET_ENV_SDK" in
        /*) ;;
        *) die "The SDK folder is not an absolute path: $DOTNET_ENV_SDK" ;;
    esac

    # DOTNET_ROOT first, wherever the list has it, so it is set before
    # anything that reads it.
    DOTNET_ENV_LINES="DOTNET_ROOT=$DOTNET_ENV_SDK
$DOTNET_ENV_LINES"
}

# Prints each NAME=value line of the list, formatted with the printf format,
# which takes the name then the value.
# Usage: print_dotnet_env_lines <format>
print_dotnet_env_lines() {
    printf '%s' "$DOTNET_ENV_LINES" | while IFS= read -r DOTNET_ENV_LINE; do
        # shellcheck disable=SC2059
        printf "$1" "${DOTNET_ENV_LINE%%=*}" "${DOTNET_ENV_LINE#*=}"
    done
}

# systemd user sessions and the units they start. environment.d(5) has no
# export keyword and expands $PATH, so PATH is appended to, not replaced.
print_dotnet_environment_d() {
    printf '# %s\n' "$DOTNET_ENV_HEADER"
    print_dotnet_env_lines '%s=%s\n'
    # A literal $PATH, for systemd to expand.
    # shellcheck disable=SC2016
    printf 'PATH=$PATH:%s\n' "$DOTNET_ENV_SDK"
}

# Login shells through /etc/profile.d and every interactive bash through the
# bash.bashrc.d loader. POSIX sh, as dash reads profile.d too, and standalone,
# as profile.d has no PATH helper of its own. Each folder is added once
# however often the file is sourced; $HOME/.dotnet/tools, where
# `dotnet tool install --global` puts tools, only when there is a HOME.
print_dotnet_shell_file() {
    printf '# shellcheck shell=sh\n# %s\n' "$DOTNET_ENV_HEADER"
    print_dotnet_env_lines 'export %s=%s\n'
    cat <<EOF
case ":\${PATH}:" in
    *:${DOTNET_ENV_SDK}:*) ;;
    *) PATH="\${PATH:+\${PATH}:}${DOTNET_ENV_SDK}" ;;
esac
if [ -n "\${HOME:-}" ]; then
    case ":\${PATH}:" in
        *":\${HOME}/.dotnet/tools:"*) ;;
        *) PATH="\${PATH}:\${HOME}/.dotnet/tools" ;;
    esac
fi
export PATH
EOF
}

# SSH and console logins, through pam_env. pam_env cannot append to PATH, so
# there is no PATH line: the /usr/local/bin/dotnet link covers those logins.
print_dotnet_pam_block() {
    printf '%s\n' "$DOTNET_ENV_BLOCK_BEGIN"
    print_dotnet_env_lines '%s DEFAULT=%s\n'
    printf '%s\n' "$DOTNET_ENV_BLOCK_END"
}

# Removes the folder the files are generated in. Run from die, so it warns
# rather than dies.
remove_dotnet_env_temp() {
    rm -rf "$DOTNET_ENV_TEMP" || warn "Failed to remove $DOTNET_ENV_TEMP"
}

# Makes the folder the files are generated in, removed again by die or by
# finish_dotnet_env_temp.
start_dotnet_env_temp() {
    DOTNET_ENV_TEMP="$(mktemp -d)" || die "Failed to create a temporary folder for the .NET environment files"
    DIE_CLEANUP=remove_dotnet_env_temp
}

finish_dotnet_env_temp() {
    # Read by die in lib/common, which this file does not source.
    # shellcheck disable=SC2034
    DIE_CLEANUP=""
    remove_dotnet_env_temp
}

# Writes pam_env.conf, without the block, into the temporary folder, and sets
# DOTNET_ENV_HAS_BLOCK to whether it had one. A missing file counts as empty.
# Dies when the markers do not pair up, as the sed range would then remove
# everything after a lone BEGIN.
write_pam_conf_without_dotnet_block() {
    DOTNET_ENV_PAM_STRIPPED="$DOTNET_ENV_TEMP/pam_env.conf"
    DOTNET_ENV_HAS_BLOCK=false
    if [ ! -e "$DOTNET_ENV_PAM_CONF" ]; then
        : > "$DOTNET_ENV_PAM_STRIPPED" || die "Failed to write $DOTNET_ENV_PAM_STRIPPED"
        return 0
    fi

    # grep -c exits 1 when it counts none, which is not a failure here.
    DOTNET_ENV_BEGINS="$(grep -cxF "$DOTNET_ENV_BLOCK_BEGIN" "$DOTNET_ENV_PAM_CONF")"
    [ $? -le 1 ] || die "Failed to read $DOTNET_ENV_PAM_CONF"
    DOTNET_ENV_ENDS="$(grep -cxF "$DOTNET_ENV_BLOCK_END" "$DOTNET_ENV_PAM_CONF")"
    [ $? -le 1 ] || die "Failed to read $DOTNET_ENV_PAM_CONF"
    [ "$DOTNET_ENV_BEGINS" = "$DOTNET_ENV_ENDS" ] || die "$DOTNET_ENV_PAM_CONF has $DOTNET_ENV_BEGINS '$DOTNET_ENV_BLOCK_BEGIN' and $DOTNET_ENV_ENDS '$DOTNET_ENV_BLOCK_END' lines; pair them up or remove them by hand, then re-run"
    [ "$DOTNET_ENV_BEGINS" = 0 ] || DOTNET_ENV_HAS_BLOCK=true

    sed '/^# BEGIN credfeto-setup-arch-desktop dotnet$/,/^# END credfeto-setup-arch-desktop dotnet$/d' "$DOTNET_ENV_PAM_CONF" > "$DOTNET_ENV_PAM_STRIPPED" || die "Failed to read $DOTNET_ENV_PAM_CONF"
}

# Deploys a generated file world-readable, whatever the umask, through sudo
# unless the folder is writable.
# Usage: install_dotnet_env_file <generated-file> <target-dir> <target-name>
install_dotnet_env_file() {
    sudo_unless_writable "$2" install -d -m 755 "$2" || die "Failed to create $2"
    sudo_unless_writable "$2" install -m 0644 "$1" "$2/$3" || die "Failed to install $2/$3"
}

# Installs every file and the link for the SDK. Installs nothing, and says
# so, when the SDK has no dotnet, so a machine without it gets no PATH entry
# to a missing folder.
install_dotnet_env() {
    read_dotnet_env_conf

    if [ ! -f "$DOTNET_ENV_SDK/dotnet" ] || [ ! -x "$DOTNET_ENV_SDK/dotnet" ]; then
        info "No .NET SDK at $DOTNET_ENV_SDK; not installing its environment"
        return 0
    fi

    start_dotnet_env_temp

    info "Installing the .NET environment for $DOTNET_ENV_SDK"
    print_dotnet_environment_d > "$DOTNET_ENV_TEMP/$DOTNET_ENV_ENVIRONMENT_D_FILE" || die "Failed to generate $DOTNET_ENV_ENVIRONMENT_D_FILE"
    print_dotnet_shell_file > "$DOTNET_ENV_TEMP/$DOTNET_ENV_SHELL_FILE" || die "Failed to generate $DOTNET_ENV_SHELL_FILE"
    install_dotnet_env_file "$DOTNET_ENV_TEMP/$DOTNET_ENV_ENVIRONMENT_D_FILE" "$DOTNET_ENV_ENVIRONMENT_D_DIR" "$DOTNET_ENV_ENVIRONMENT_D_FILE"
    install_dotnet_env_file "$DOTNET_ENV_TEMP/$DOTNET_ENV_SHELL_FILE" "$DOTNET_ENV_PROFILE_D_DIR" "$DOTNET_ENV_SHELL_FILE"
    install_dotnet_env_file "$DOTNET_ENV_TEMP/$DOTNET_ENV_SHELL_FILE" "$DOTNET_ENV_BASHRC_D_DIR" "$DOTNET_ENV_SHELL_FILE"

    # Any block already there is replaced, so a re-run leaves exactly one,
    # holding the list's current values.
    write_pam_conf_without_dotnet_block
    print_dotnet_pam_block >> "$DOTNET_ENV_PAM_STRIPPED" || die "Failed to generate the pam_env block"
    install_dotnet_env_file "$DOTNET_ENV_PAM_STRIPPED" "$DOTNET_ENV_PAM_DIR" pam_env.conf

    finish_dotnet_env_temp

    # Lets anything with a minimal PATH, such as sshd's default one, find
    # dotnet. Anything else already there was not made here, so it is left.
    if [ -e "$DOTNET_ENV_LINK" ] && [ ! -L "$DOTNET_ENV_LINK" ]; then
        warn "Not linking $DOTNET_ENV_LINK to $DOTNET_ENV_SDK/dotnet: something other than a link is already there"
    else
        sudo_unless_writable "$DOTNET_ENV_BIN_DIR" install -d -m 755 "$DOTNET_ENV_BIN_DIR" || die "Failed to create $DOTNET_ENV_BIN_DIR"
        sudo_unless_writable "$DOTNET_ENV_BIN_DIR" ln -sfn "$DOTNET_ENV_SDK/dotnet" "$DOTNET_ENV_LINK" || die "Failed to link $DOTNET_ENV_LINK to $DOTNET_ENV_SDK/dotnet"
    fi
}

# Removes a generated file when it is there.
# Usage: remove_dotnet_env_file <dir> <name>
remove_dotnet_env_file() {
    [ -e "$1/$2" ] || [ -L "$1/$2" ] || return 0
    sudo_unless_writable "$1" rm -f "$1/$2" || die "Failed to remove $1/$2"
}

# Removes every file, the pam_env block and the link install_dotnet_env makes.
# The link only when it still points at this SDK's dotnet, so one made for
# another SDK is left alone. Safe to run when none of them is there.
remove_dotnet_env() {
    read_dotnet_env_conf

    info "Removing the .NET environment for $DOTNET_ENV_SDK"
    remove_dotnet_env_file "$DOTNET_ENV_ENVIRONMENT_D_DIR" "$DOTNET_ENV_ENVIRONMENT_D_FILE"
    remove_dotnet_env_file "$DOTNET_ENV_PROFILE_D_DIR" "$DOTNET_ENV_SHELL_FILE"
    remove_dotnet_env_file "$DOTNET_ENV_BASHRC_D_DIR" "$DOTNET_ENV_SHELL_FILE"

    start_dotnet_env_temp
    write_pam_conf_without_dotnet_block
    if [ "$DOTNET_ENV_HAS_BLOCK" = true ]; then
        install_dotnet_env_file "$DOTNET_ENV_PAM_STRIPPED" "$DOTNET_ENV_PAM_DIR" pam_env.conf
    fi
    finish_dotnet_env_temp

    if [ -L "$DOTNET_ENV_LINK" ] && [ "$(readlink "$DOTNET_ENV_LINK")" = "$DOTNET_ENV_SDK/dotnet" ]; then
        sudo_unless_writable "$DOTNET_ENV_BIN_DIR" rm -f "$DOTNET_ENV_LINK" || die "Failed to remove $DOTNET_ENV_LINK"
    fi
}
