# shellcheck shell=sh

_emit() {
    symbol="$1"
    color="$2"
    fd="$3"
    shift 3
    if [ -t "$fd" ]; then
        printf '\n\033[%sm%s\033[0m %s\n' "$color" "$symbol" "$*" >&"$fd"
    else
        printf '\n%s %s\n' "$symbol" "$*" >&"$fd"
    fi
}

# A function can name a command in DIE_CLEANUP for die to run before it
# exits, to undo a half-made change, and clear it once the change is
# complete. Set here so nothing in the environment can name one. Cleared
# before it runs, so a clean-up that dies does not run itself again.
DIE_CLEANUP=""

die() {
    _emit '✗' 31 2 "$@"
    if [ -n "$DIE_CLEANUP" ]; then
        DIE_CLEANING_UP="$DIE_CLEANUP"
        DIE_CLEANUP=""
        "$DIE_CLEANING_UP"
    fi
    exit 1
}

success() {
    _emit '✓' 32 1 "$@"
}

warn() {
    _emit '⚠' 33 2 "$@"
}

info() {
    _emit '→' 32 1 "$@"
}

# Returns true (0) when running inside a Claude Code Bash-tool session.
# Claude Code sets CLAUDECODE=1 in every shell it spawns via the Bash tool;
# that value is inherited by subprocesses (e.g. git hooks).
# Source: https://docs.anthropic.com/en/docs/claude-code/settings#environment-variables
is_ai_agent() {
    [ "${CLAUDECODE}" = "1" ]
}

# Usage: refuse_ai_agent <script-name>
refuse_ai_agent() {
    if is_ai_agent; then
        die "Prohibited: $1 must not be run from a Claude Code session"
    fi
}

# Dies before anything has changed when the caller's own systemd user manager
# cannot be reached, so a later `systemctl --user` call cannot fail midway.
# Root is refused by uid, not left to the probe: root can have a user manager
# of its own, which the probe would accept, and the scripts call sudo
# themselves where they need it.
# show-environment only reads from the manager, so the probe changes nothing.
# Usage: require_user_session <script-name>
require_user_session() {
    [ "$(id -u)" != "0" ] || die "$1 must not be run as root; run it as your normal user, as it calls sudo itself where it needs to"
    systemctl --user show-environment >/dev/null 2>&1 || die "Cannot reach your systemd user manager; run $1 from a logged-in session (desktop, console or SSH login) as your normal user, not through su or sudo"
}

# Returns true (0) when NetworkManager is the host's active network manager,
# so NetworkManager-only work can be skipped on a systemd-networkd host.
network_manager_active() {
    systemctl is-active --quiet NetworkManager.service
}

# Dies at once rather than waiting for the network, so a manual run fails
# fast when offline. network-online exits 1 when offline and 255 when no
# supported network manager is running; any other status means the check
# itself could not run.
# Usage: require_network <path-to-network-online>
require_network() {
    "$1" && return 0
    NETWORK_STATUS=$?

    case "${NETWORK_STATUS}" in
        1) die "No network connection" ;;
        255) die "No supported network manager (NetworkManager or systemd-networkd) is running" ;;
        *) die "Network check $1 failed with exit status ${NETWORK_STATUS}" ;;
    esac
}

# Runs a script from a reference clone, passing any further arguments on.
# Usage: run_reference_step <repo>/<path-in-repo> [<arg> ...]
run_reference_step() {
    STEP="${DEV_REFERENCE_DIR}/$1"
    shift

    [ -x "${STEP}" ] || die "Not found or not executable: ${STEP}"

    info "Running ${STEP}${*:+ $*}..."
    "${STEP}" "$@" || die "Failed to run ${STEP}"
}

# Dies unless the directory is the top level of a git work tree. git -C on a
# directory that is not one searches up the tree, so the status, switch and
# pull that follow would act on an enclosing repo (such as a dotfiles repo in
# $HOME) instead. --show-toplevel prints a resolved path, hence pwd -P. git
# also refuses a checkout owned by another account ("dubious ownership"),
# which fails the check the same way. The message defaults to one for a
# reference clone.
# Usage: require_clone_toplevel <dir> [<message>]
require_clone_toplevel() {
    CLONE_TOPLEVEL="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || CLONE_TOPLEVEL=""
    CLONE_RESOLVED="$(cd "$1" && pwd -P)" || die "Failed to resolve $1"
    [ "${CLONE_TOPLEVEL}" = "${CLONE_RESOLVED}" ] || die "${2:-$1 exists but is not a git clone; move or delete it, then re-run}"
}

# Clones a reference repo from GitHub over SSH when it is missing; an existing
# clone is left alone once checked to be one. The clone directory is named
# after the repo only, so the owner never appears in a path.
# Usage: clone_reference_repo <owner>/<repo>
clone_reference_repo() {
    mkdir -p "${DEV_REFERENCE_DIR}" || die "Failed to create ${DEV_REFERENCE_DIR}"

    CLONE_REPO="${1#*/}"
    CLONE_PATH="${DEV_REFERENCE_DIR}/${CLONE_REPO}"
    if [ -d "${CLONE_PATH}" ]; then
        require_clone_toplevel "${CLONE_PATH}"
        return 0
    fi

    info "Cloning ${CLONE_REPO} into ${CLONE_PATH}..."
    git clone "git@github.com:$1.git" "${CLONE_PATH}" || die "Failed to clone ${CLONE_REPO}"
}

# Switches an existing reference clone to main and fast-forwards it. Never
# forces, resets or stashes: uncommitted changes, a failed switch or a
# diverged main stop the run so nothing is lost.
# Usage: update_reference_repo <owner>/<repo>
update_reference_repo() {
    CLONE_PATH="${DEV_REFERENCE_DIR}/${1#*/}"

    CLONE_STATUS="$(git -C "${CLONE_PATH}" status --porcelain)" || die "Failed to read the status of ${CLONE_PATH}"
    [ -z "${CLONE_STATUS}" ] || die "Uncommitted changes in ${CLONE_PATH}; commit or discard them, then re-run"

    info "Updating ${CLONE_PATH} to the latest main..."
    git -C "${CLONE_PATH}" switch main || die "Failed to switch ${CLONE_PATH} to main"
    git -C "${CLONE_PATH}" pull --ff-only || die "Failed to fast-forward ${CLONE_PATH}; main may have diverged from its upstream"
}

# Reference clone layout. settings/bash.bashrc.d/95_update.sh and
# units/dev-update/dev-update.service cannot source this file, so they repeat
# the default path; keep them in step with it. DEV_REFERENCE_DIR is a test
# seam only, so a test can point it at a temp dir of its own: the units only
# support the default, so dev-install refuses any other value.
DEV_REFERENCE_DEFAULT_DIR="${HOME}/work/reference"
DEV_REFERENCE_DIR="${DEV_REFERENCE_DIR:-${DEV_REFERENCE_DEFAULT_DIR}}"
# Each entry is <owner>/<repo> on GitHub; the clone lands in
# ${DEV_REFERENCE_DIR}/<repo>. Consumed by the settings/scripts/ that source
# this file rather than by lib/common itself, hence the SC2034 disable.
# shellcheck disable=SC2034
DEV_REFERENCE_REPOS="credfeto/credfeto-setup-arch-desktop credfeto/credfeto-global-pre-commit credfeto/cs-template credfeto/credfeto-orchestrator dnyw4l3n13/claude credfeto/credfeto-ai-skills"

# Dies unless the folder a step deploys from is the top of its own git work
# tree, before the step lists anything with list_tracked_files: outside one (a
# downloaded archive) git would fail with nothing to say why, and inside
# another repository it would list what that repository tracks instead.
# Called on its own rather than from list_tracked_files, whose callers run
# it in $(...), where a die only ends that subshell and the caller's own
# message would follow this one. Also dies while a merge or rebase has left
# conflicts: a conflicted file's working-tree content holds conflict
# markers, which would break a shell or sshd that reads the deployed copy,
# and git lists such a file once per stage.
# Usage: require_deploy_checkout <checkout>
require_deploy_checkout() {
    require_clone_toplevel "$1" "$1 is not a git checkout; run install from a git clone of this repository, as only the files git tracks are deployed"
    DEPLOY_UNMERGED="$(git -C "$1" ls-files --unmerged)" || die "Failed to check $1 for unresolved merge conflicts"
    [ -z "$DEPLOY_UNMERGED" ] || die "$1 has unresolved merge conflicts; resolve them or abort the merge, then re-run"
}

# Prints, relative to the checkout, every file git tracks there that matches
# one of the pathspecs and is still a regular file, not a symlink, in the
# working tree, one per line. A step that deploys a folder's files lists them with this rather
# than a glob, so an untracked, ignored or private file left beside them is
# never deployed; the working tree's content is what gets deployed, so an
# uncommitted edit to a tracked file is included. Pass ":(glob)<dir>/*.<ext>"
# to match only a folder's own files, as * then does not cross a /. Without
# -z: no deployed file name holds a newline, and quotePath is off so other
# names print as they are. Call require_deploy_checkout on the checkout
# first. Fails when git cannot list them.
# Usage: list_tracked_files <checkout> <pathspec> [<pathspec> ...]
list_tracked_files() {
    TRACKED_CHECKOUT="$1"
    shift
    TRACKED_LIST=$(git -C "$TRACKED_CHECKOUT" -c core.quotePath=false ls-files -- "$@") || return 1
    printf '%s\n' "$TRACKED_LIST" | while IFS= read -r TRACKED_PATH; do
        # A symlink is skipped, tracked or not: deploying it would copy
        # whatever it points at, such as a private key in the caller's home,
        # into a world-readable place. Warned about, so a link tracked on
        # purpose is not dropped unnoticed.
        if [ -L "$TRACKED_CHECKOUT/$TRACKED_PATH" ]; then
            warn "Not deploying $TRACKED_CHECKOUT/$TRACKED_PATH: it is a symlink, and only regular files are deployed"
        elif [ -f "$TRACKED_CHECKOUT/$TRACKED_PATH" ]; then
            printf '%s\n' "$TRACKED_PATH"
        fi
    done
}

# Runs a command directly when the given directory is writable by the caller
# (or does not exist yet and can be created by them), otherwise through sudo,
# so a test can point a system location at a folder of its own and run
# without root, while the real system locations still go through sudo.
# Usage: sudo_unless_writable <dir> <command> [<arg> ...]
sudo_unless_writable() {
    SUDO_UNLESS_DIR="$1"
    shift
    if [ -w "$SUDO_UNLESS_DIR" ] || { [ ! -e "$SUDO_UNLESS_DIR" ] && [ -w "$(dirname "$SUDO_UNLESS_DIR")" ]; }; then
        "$@"
    else
        sudo "$@"
    fi
}

# Versioned folders sit beside a stable link to the current one, named
# <link name>-<UTC timestamp>; prune_versioned_folders matches that shape.

# Prints a new versioned folder name for the given link name. Nanoseconds,
# so two runs within the same second never collide. Fails when the time
# cannot be read.
# The stamp's shape is matched digit for digit by the glob in
# prune_versioned_folders; change the two together.
# Usage: versioned_folder_name <link-name>
versioned_folder_name() {
    VERSIONED_STAMP="$(date -u +%Y%m%dT%H%M%S.%NZ)" || return 1
    printf '%s-%s\n' "$1" "$VERSIONED_STAMP"
}

# Switches a stable link to the named versioned folder beside it: a new link
# renamed over the old one, so the path is never missing or half-switched
# for anything reading it. Leaves the folder the link pointed at before, or
# nothing, in SWITCHED_FROM, for the caller to keep. The runner is the name
# of a command or function that runs its arguments with whatever privilege
# the link's folder needs.
# Usage: switch_versioned_link <runner> <link> <folder-name>
switch_versioned_link() {
    SWITCH_RUNNER="$1"
    SWITCH_LINK="$2"
    SWITCH_NAME="$3"
    SWITCH_PARENT="$(dirname "$SWITCH_LINK")"
    SWITCH_TARGET="$SWITCH_PARENT/$SWITCH_NAME"
    SWITCH_TEMP="$SWITCH_PARENT/.${SWITCH_LINK##*/}.tmp"

    SWITCHED_FROM="$(readlink "$SWITCH_LINK" 2>/dev/null)" || SWITCHED_FROM=""
    "$SWITCH_RUNNER" ln -sfn "$SWITCH_NAME" "$SWITCH_TEMP" || die "Failed to create a link to $SWITCH_TARGET"
    "$SWITCH_RUNNER" mv -T "$SWITCH_TEMP" "$SWITCH_LINK" || die "Failed to switch $SWITCH_LINK to $SWITCH_TARGET"
}

# Removes every versioned folder beside the link but the two named ones. It
# runs only after a switch, so a partial folder a failed run could not clean
# up itself (one killed outright, say) stays until the next switch. Always
# through sudo: the folders are given to root, so only root can empty them,
# even when the folder holding them is writable. The noun names a folder in
# the messages.
# Usage: prune_versioned_folders <link> <noun> <keep-name> <keep-name>
prune_versioned_folders() {
    PRUNE_LINK="$1"
    PRUNE_NOUN="$2"
    PRUNE_KEEP_CURRENT="$3"
    PRUNE_KEEP_PREVIOUS="$4"
    # Called only once the link points at a folder that now exists, so the
    # glob always matches at least that and never comes through unexpanded.
    # It spells out versioned_folder_name's %Y%m%dT%H%M%S.%NZ stamp, so a
    # sibling whose own name starts <link>-<digit> (claude-2 beside claude)
    # never has its folders taken for this link's.
    for PRUNE_OLD in "$PRUNE_LINK"-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9].[0-9]*Z; do
        case "${PRUNE_OLD##*/}" in
            "$PRUNE_KEEP_CURRENT" | "$PRUNE_KEEP_PREVIOUS") continue ;;
        esac

        info "Removing old $PRUNE_NOUN $PRUNE_OLD"
        sudo rm -rf "$PRUNE_OLD" || die "Failed to remove the old $PRUNE_NOUN $PRUNE_OLD"
    done
}

# Makes a run lock file readable by every account if it is not there yet.
# touch and chmod keep an existing file's inode, so a run already holding the
# lock still excludes this one; chmod, rather than the umask, makes the file
# readable by every account. It is only ever opened for reading, which flock
# allows, so whoever owns it never stops anyone else taking the lock. Never
# removed: a run that recreated it would lock a different file from a run
# already holding the old one. The caller opens and locks it itself: exec
# takes its descriptor number literally, so only eval could pass one in.
# Usage: create_lock_file <runner> <lock-file>
create_lock_file() {
    [ -r "$2" ] || { "$1" touch "$2" && "$1" chmod 0644 "$2"; } || die "Failed to create $2"
}

# Seconds a run waits for another run to release a run lock before giving
# up. Two accounts' dev-update timers can fire together, so stopping at once
# would fail the second unit and skip its later steps; a bound still stops a
# run stuck behind one that has hung. Overridable so a test need not wait.
RUN_LOCK_WAIT_SECONDS="${RUN_LOCK_WAIT_SECONDS:-300}"

# Takes the lock on an already open descriptor, waiting up to
# RUN_LOCK_WAIT_SECONDS, and saying so, when another run holds it. flock
# takes the descriptor as an argument, so unlike exec it can be passed in.
# Usage: wait_for_run_lock <fd> <lock-file> <holder>
wait_for_run_lock() {
    flock -n "$1" && return 0
    info "Waiting up to ${RUN_LOCK_WAIT_SECONDS}s for $3 to release $2"
    flock -w "$RUN_LOCK_WAIT_SECONDS" "$1" || die "Timed out after ${RUN_LOCK_WAIT_SECONDS}s waiting for $3 to release $2"
}

# Published snapshot layout: ${DEV_PUBLISH_DIR}/<repo> is a symlink to the
# current <repo>-<UTC timestamp> snapshot, so system-wide installs never point
# into a reference clone that can be switched or edited. DEV_PUBLISH_DIR is a
# test seam only, so a test can point it at a temp dir of its own.
DEV_PUBLISH_DIR="${DEV_PUBLISH_DIR:-/usr/local/share/development}"
# Hidden, so it never matches a <repo>-<timestamp> snapshot or a <repo> link.
DEV_PUBLISH_LOCK_FILE="${DEV_PUBLISH_DIR}/.publish.lock"
# Written at the root of each snapshot: the git tree id it was made from, so
# a publish of an unchanged clone keeps the snapshot it has. Hidden, so an
# installer listing the snapshot's files with a glob never sees it.
PUBLISHED_TREE_RECORD=".published-tree"

# Runs a command directly when DEV_PUBLISH_DIR is writable (or can be created),
# otherwise through sudo.
dev_publish_sudo() {
    sudo_unless_writable "${DEV_PUBLISH_DIR}" "$@"
}

# Takes the publish lock on fd 8. The dev-update lock is per account, and
# each publish removes the snapshots it does not keep, so two accounts
# publishing at once could delete the snapshot the other is about to switch
# to. A second run waits for the first, within a bound, rather than failing.
# publish_reference_repo releases it before returning, so a run
# that publishes several repos never waits on itself, and nothing started
# afterwards (an installer, a build server) inherits a held lock.
lock_dev_publish_dir() {
    create_lock_file dev_publish_sudo "${DEV_PUBLISH_LOCK_FILE}"

    # command, as a failed redirection on a bare exec ends a POSIX shell
    # before the die can name the lock.
    command exec 8<"${DEV_PUBLISH_LOCK_FILE}" || die "Failed to open ${DEV_PUBLISH_LOCK_FILE}"
    wait_for_run_lock 8 "${DEV_PUBLISH_LOCK_FILE}" "another publish"
}

# Removes the snapshot publish_reference_repo made but never switched to, so
# a failed publish leaves no half-filled snapshot behind. Always sudo, as the
# snapshot may already belong to root. Run from die, so it warns rather than
# dies.
remove_unswitched_snapshot() {
    sudo rm -rf "${UNSWITCHED_SNAPSHOT}" || warn "Failed to remove the unfinished snapshot ${UNSWITCHED_SNAPSHOT}"
}

# Publishes the committed HEAD of a reference clone as a new root-owned
# snapshot and switches ${DEV_PUBLISH_DIR}/<repo> to it. git archive takes
# only the tree of HEAD, read once, so untracked or ignored files in the
# clone are never published.
# The snapshot the link pointed at before is kept, so anything still running
# from it is not pulled out from under it; any older one is removed. When
# the link already holds the clone's committed tree, nothing is published.
# Usage: publish_reference_repo <repo>
publish_reference_repo() {
    PUBLISH_REPO="$1"
    PUBLISH_CLONE="${DEV_REFERENCE_DIR}/${PUBLISH_REPO}"
    PUBLISH_LINK="${DEV_PUBLISH_DIR}/${PUBLISH_REPO}"
    PUBLISH_NAME="$(versioned_folder_name "${PUBLISH_REPO}")" || die "Failed to name a snapshot of ${PUBLISH_REPO}"
    PUBLISH_SNAPSHOT="${DEV_PUBLISH_DIR}/${PUBLISH_NAME}"
    # The tree of the commit being published, recorded in each snapshot. A
    # clone git cannot read a tree from has no commit to publish, which
    # git archive would fail on anyway, so it stops here with a clearer message.
    PUBLISH_TREE="$(git -C "${PUBLISH_CLONE}" rev-parse 'HEAD^{tree}')" || die "Failed to read the committed tree of ${PUBLISH_CLONE}"

    dev_publish_sudo mkdir -p "${DEV_PUBLISH_DIR}" || die "Failed to create ${DEV_PUBLISH_DIR}"
    # Explicit rather than umask-dependent, so a user with a strict umask
    # still gets a publish directory every account can read.
    dev_publish_sudo chmod 755 "${DEV_PUBLISH_DIR}" || die "Failed to set permissions on ${DEV_PUBLISH_DIR}"
    lock_dev_publish_dir

    # Only ever a link this function switches. Anything else there (a folder
    # made by hand or by an older layout) would fail every switch after a
    # whole snapshot had been built, so it is left for the user to move
    # rather than moved or deleted here.
    if [ -e "${PUBLISH_LINK}" ] && [ ! -L "${PUBLISH_LINK}" ]; then
        die "${PUBLISH_LINK} exists but is not a symlink; move it aside, then re-run"
    fi

    # Kept when it already holds this tree, so a run with nothing new to
    # publish makes no snapshot and prunes none: a new one every run would
    # remove the snapshot a long-running process or an installer started
    # from within two runs. A snapshot without a record (an older layout) or
    # a dangling link counts as changed.
    if [ -L "${PUBLISH_LINK}" ] && [ -r "${PUBLISH_LINK}/${PUBLISHED_TREE_RECORD}" ]; then
        PUBLISHED_TREE=""
        read -r PUBLISHED_TREE < "${PUBLISH_LINK}/${PUBLISHED_TREE_RECORD}" || PUBLISHED_TREE=""
        if [ "${PUBLISHED_TREE}" = "${PUBLISH_TREE}" ]; then
            exec 8<&-
            info "${PUBLISH_LINK} already holds the committed tree of ${PUBLISH_CLONE}; keeping it"
            return 0
        fi
    fi

    info "Publishing ${PUBLISH_CLONE} to ${PUBLISH_SNAPSHOT}..."

    # Refused before the clean-up is armed, so it never removes a snapshot
    # this run did not make: the clock stepping back can name one an earlier
    # run kept.
    if [ -e "${PUBLISH_SNAPSHOT}" ] || [ -L "${PUBLISH_SNAPSHOT}" ]; then
        die "${PUBLISH_SNAPSHOT} already exists; move it aside, then re-run"
    fi

    # Armed before the mkdir and disarmed once the link is switched, so any
    # step between them that dies removes the half-made snapshot first.
    UNSWITCHED_SNAPSHOT="${PUBLISH_SNAPSHOT}"
    DIE_CLEANUP=remove_unswitched_snapshot
    dev_publish_sudo mkdir "${PUBLISH_SNAPSHOT}" || die "Failed to create ${PUBLISH_SNAPSHOT}"

    PUBLISH_ARCHIVE="$(mktemp)" || die "Failed to create a temporary file for ${PUBLISH_REPO}"
    # The tree read before the lock, not HEAD: the clone can move on while
    # this run waits, and the snapshot must hold exactly the tree it records.
    if ! git -C "${PUBLISH_CLONE}" archive --format=tar -o "${PUBLISH_ARCHIVE}" "${PUBLISH_TREE}"; then
        rm -f "${PUBLISH_ARCHIVE}"
        die "Failed to archive ${PUBLISH_CLONE}"
    fi
    if ! dev_publish_sudo tar -x -f "${PUBLISH_ARCHIVE}" -C "${PUBLISH_SNAPSHOT}"; then
        rm -f "${PUBLISH_ARCHIVE}"
        die "Failed to extract ${PUBLISH_REPO} into ${PUBLISH_SNAPSHOT}"
    fi
    rm -f "${PUBLISH_ARCHIVE}"

    # Written before the chmod and chown below, so it is root-owned and
    # world-readable like the rest of the snapshot.
    printf '%s\n' "${PUBLISH_TREE}" | dev_publish_sudo tee "${PUBLISH_SNAPSHOT}/${PUBLISHED_TREE_RECORD}" > /dev/null || die "Failed to record the published tree in ${PUBLISH_SNAPSHOT}"

    dev_publish_sudo chmod -R u=rwX,go=rX "${PUBLISH_SNAPSHOT}" || die "Failed to set permissions on ${PUBLISH_SNAPSHOT}"
    # Always sudo: only root can give files to root, even in a writable directory.
    sudo chown -R root:root "${PUBLISH_SNAPSHOT}" || die "Failed to make ${PUBLISH_SNAPSHOT} owned by root"

    switch_versioned_link dev_publish_sudo "${PUBLISH_LINK}" "${PUBLISH_NAME}"
    DIE_CLEANUP=""
    prune_versioned_folders "${PUBLISH_LINK}" snapshot "${PUBLISH_NAME}" "${SWITCHED_FROM}"

    # Closing the descriptor releases the lock.
    exec 8<&-

    success "Published ${PUBLISH_REPO} to ${PUBLISH_LINK}"
}

# Runs a system-wide installer from its published snapshot with --system.
# The installer is judged only by its exit code, so it must either install
# system-wide for --system or exit non-zero.
# Usage: run_published_step <repo>/<path-in-repo>
run_published_step() {
    STEP="${DEV_PUBLISH_DIR}/$1"

    [ -x "${STEP}" ] || die "Not found or not executable: ${STEP}"

    info "Running ${STEP} --system..."
    "${STEP}" --system || die "Failed to run ${STEP}"
}

# Publishes a reference clone, then runs one of its installers from the
# snapshot just published.
# Usage: run_published_installer <repo> <path-in-repo>
run_published_installer() {
    publish_reference_repo "$1"
    run_published_step "$1/$2"
}

# Directory the flag probes below look in. Overridable so a test can point it
# at a temp dir of its own and control each flag; defaults to the real
# location of the binaries.
INSTALL_STATE_BIN_DIR="${INSTALL_STATE_BIN_DIR:-/usr/bin}"

# Install-state flags, shared by multiple install.d/ scripts. Recomputed on
# every source (not exported from `install`) so a script run standalone still
# sees correct values without `install` having run first. Written as `if`
# blocks rather than trailing `[ cond ] && VAR=1` so this file's own source
# exit status stays 0 regardless of which flags end up set.
#
# Each is consumed by install.d/* scripts that source this file, not by
# lib/common itself, so shellcheck's single-file analysis can't see the
# consumer; disabled per-declaration (not file-wide) so a genuinely unused
# variable added later in this file still gets caught.
# shellcheck disable=SC2034
DOCKER_INSTALLED=0
# shellcheck disable=SC2034
INCUS_INSTALLED=0
# shellcheck disable=SC2034
FLATPAK_INSTALLED=0
# shellcheck disable=SC2034
ZOOM_INSTALLED=0

if [ -f "${INSTALL_STATE_BIN_DIR}/docker" ]; then
    # shellcheck disable=SC2034
    DOCKER_INSTALLED=1
fi
if [ -f "${INSTALL_STATE_BIN_DIR}/incus" ]; then
    # shellcheck disable=SC2034
    INCUS_INSTALLED=1
fi
if [ -f "${INSTALL_STATE_BIN_DIR}/flatpak" ]; then
    # shellcheck disable=SC2034
    FLATPAK_INSTALLED=1
fi
if [ -f "${INSTALL_STATE_BIN_DIR}/zoom" ]; then
    # shellcheck disable=SC2034
    ZOOM_INSTALLED=1
fi
